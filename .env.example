FLASK_ENV=development
FLASK_APP=app.py
DEBUG=True
# App host port binding. Keep on loopback when using a host reverse proxy.
APP_HOST_BIND_ADDRESS=127.0.0.1
# Set to the trusted proxy count only when direct public access to the app port is blocked.
TRUSTED_PROXY_COUNT=0

# Database Configuration
DATABASE_URL=mysql+pymysql://root:password@localhost/habit_tracker

# JWT Configuration
JWT_SECRET_KEY=jwt-secret-key-change-in-production-habitflow

# Flask Configuration
SECRET_KEY=dev-secret-key-change-in-production-habitflow

# Optional: Email Configuration (for reminders)
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password
MAIL_DEFAULT_SENDER=your-email@gmail.com

# Frontend
FRONTEND_URL=http://localhost:5000
